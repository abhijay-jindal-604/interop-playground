# interop-playground environment (plan/10 §8.3). Copy to .env; scripts/up.sh creates .env from
# this file when it is missing and fills PUBLIC_HOST. Secrets never go here: scripts/up.sh writes
# them to .env.local (generated, mode 0600). Compose reads `--env-file .env --env-file .env.local`.

# Host IPv4 that every advertised URL names (ADR-06). Empty = scripts/up.sh detects the source
# address of the main-table default route and writes it here. Never 127.0.0.1: containers must reach it.
PUBLIC_HOST=

# Compose profiles. local = full-local mode (default); collab mode = empty (core only).
# scripts/up.sh --mode / --with rewrite this line (values: local, mdoc-spec, peers, iae, debug).
COMPOSE_PROFILES=local

# BFF (Fastify) log level: fatal, error, warn, info, debug, trace.
BFF_LOG_LEVEL=info

# local | collab (02 §2). scripts/up.sh --mode rewrites it together with COMPOSE_PROFILES.
PLAYGROUND_MODE=local

# Request cap per minute for calls to collab.mosip.net (02 §6.3).
COLLAB_BUDGET_RPM=20

# Optional: mock UIN / OTP for the best-effort Collab auth-code run (never printed).
COLLAB_ESIGNET_MOCK_UIN=
COLLAB_ESIGNET_MOCK_OTP=

# Optional: named Cloudflare tunnel; read only by scripts/tunnel.sh (10 §10, RISK-08).
TUNNEL_TOKEN=
TUNNEL_HOSTNAME=

# Not set here (for reference):
#   INJI_VERIFY_REDIRECT_URI   fixed http://127.0.0.1:3100/return/vp in compose.yaml (S-200)
#   ESIGNET_KEYSTORE_PASSWORD  .env.local, random, Mimoto oidckeystore.p12 password
#   NODE_EXTRA_CA_CERTS, JAVA_TOOL_OPTIONS, DATA_DIR, FLOWS_DIR, CONFIG_DIR  set in compose.yaml
