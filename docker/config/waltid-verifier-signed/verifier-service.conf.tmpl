# waltid-verifier-api2-signed (ADR-48, S-205): Ed25519-signed requests for wallet.inji-jvm.
# clientId and key are rendered from certs/peers/waltid-verifier-ed25519.json (generated by scripts/up.sh).
clientId: "decentralized_identifier:${WALTID_VERIFIER_DID}"

clientMetadata: {
   client_name: "Verifier2"
   logo_uri: "https://images.squarespace-cdn.com/content/v1/609c0ddf94bcc0278a7cbdb4/4d493ccf-c893-4882-925f-fda3256c38f4/Walt.id_Logo_transparent.png"
}

urlPrefix: "https://${PUBLIC_HOST}:18445/verification-session"

urlHost: "openid4vp://authorize"

key: {"type": "jwk", "jwk": ${WALTID_VERIFIER_KEY_JWK}}
